# Receiver Side - Correct Data
received_code = codeword.copy()

print("\n--- RECEIVER SIDE ---")
print("Received codeword:", ''.join(map(str, received_code[1:])))

corrected_code = detect_and_correct(received_code)

print("Corrected codeword:", ''.join(map(str, corrected_code[1:])))
print("Recovered data:", extract_data(corrected_code))

